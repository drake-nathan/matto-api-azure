{
  "name": "matto-api-azure",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "azurite": "azurite --silent",
    "build": "tsc",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "lint:inspect": "eslint --inspect-config",
    "prettify": "npm run format && npm run lint",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest",
    "typecheck": "tsc --pretty --noEmit",
    "watch": "tsc -w"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "dist"
    ]
  },
  "dependencies": {
    "@azure/storage-blob": "^12.27.0",
    "axios": "^1.10.0",
    "canvas": "^2.11.2",
    "dotenv": "^17.0.0",
    "hjson": "^3.2.2",
    "jsdom": "^24.1.3",
    "lodash": "^4.17.21",
    "mongoose": "^6.13.8",
    "puppeteer": "^22.15.0",
    "sharp": "^0.33.3",
    "viem": "^2.31.4",
    "web3": "^1.10.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@azure/functions": "^3.5.1",
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@types/hjson": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.19",
    "@types/node": "^22.15.34",
    "@types/ws": "^8.5.10",
    "azurite": "^3.33.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "js-style-kit": "^0.4.2",
    "typescript": "^5.8.3",
    "web3-eth-contract": "^1.10.4",
    "web3-utils": "^1.10.4"
  },
  "engines": {
    "node": ">=20"
  }
}
